Sub RefreshAllPivotTablesInAllWorkbooks() '[Step A] Setup – declare iterators and ensure calc is automatic
    Dim wb As Workbook, ws As Worksheet, pt As PivotTable: Application.Calculation = xlCalculationAutomatic
    '[Step B] Iterate books & sheets – traverse every worksheet in every open workbook
    For Each wb In Application.Workbooks: For Each ws In wb.Worksheets
        '[Step C] Refresh pivots – loop each PivotTable and refresh (ignore already-busy errors)
        For Each pt In ws.PivotTables: On Error Resume Next: pt.RefreshTable: On Error GoTo 0
        Next pt
    Next ws: Next wb
End Sub
