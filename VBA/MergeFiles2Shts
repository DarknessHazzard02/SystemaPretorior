Sub MergeFilesIntoSeparateSheets() '[Step A] Pick folder – user selects source folder for Excel files
    Dim FolderPath As String, Filename As String, SourceWb As Workbook, SourceWs As Worksheet, TargetWb As Workbook
    With Application.FileDialog(msoFileDialogFolderPicker): .Title = "Select Folder with the 6 Excel Files": If .Show <> -1 Then Exit Sub: FolderPath = .SelectedItems(1) & "\": End With
    '[Step B] Optimize – speed up UI and suppress prompts
    Application.ScreenUpdating = False: Application.DisplayAlerts = False
    '[Step C] Create target – new workbook to receive copied sheets (remove default sheet)
    Set TargetWb = Workbooks.Add(xlWBATWorksheet): On Error Resume Next: TargetWb.Sheets(1).Delete: On Error GoTo 0
    '[Step D] Iterate files – open each Excel file and copy its first sheet to target
    Filename = Dir(FolderPath & "*.xls*"): Do While Filename <> "": Set SourceWb = Workbooks.Open(FolderPath & Filename): Set SourceWs = SourceWb.Sheets(1): SourceWs.Copy After:=TargetWb.Sheets(TargetWb.Sheets.Count)
        '[Step E] Rename copied sheet – match source filename (without extension), tolerate duplicates
        On Error Resume Next: TargetWb.Sheets(TargetWb.Sheets.Count).Name = Left(Filename, InStrRev(Filename, ".") - 1): On Error GoTo 0
        SourceWb.Close SaveChanges:=False: Filename = Dir
    Loop
    '[Step F] Restore – re‑enable prompts and UI updates
    Application.DisplayAlerts = True: Application.ScreenUpdating = True
End Sub
