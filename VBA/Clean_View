Option Explicit

Sub GoToFirstSheetInAllWorkbooks()
    Dim wb As Workbook
    For Each wb In Application.Workbooks
        On Error Resume Next
        wb.Worksheets(1).Activate
        On Error GoTo 0
    Next wb
    Application.Calculation = xlCalculationAutomatic
End Sub

