Sub ClearAllFiltersInAllWorkbooks() '[Step A] Setup – declare iterators and optimize calc
    Dim wb As Workbook, ws As Worksheet, lo As ListObject: Application.Calculation = xlCalculationManual
    '[Step B] Loop all workbooks & sheets – target every worksheet in every open workbook
    For Each wb In Application.Workbooks: For Each ws In wb.Worksheets
        '[Step C] Clear worksheet AutoFilter – disable filter mode if active
        If ws.AutoFilterMode Then ws.AutoFilterMode = False
        '[Step D] Reset table filters – iterate tables; show all rows, ignore already‑clear errors
        For Each lo In ws.ListObjects: If lo.ShowAutoFilter Then On Error Resume Next: lo.AutoFilter.ShowAllData: On Error GoTo 0
        Next lo
    Next ws: Next wb
End Sub
