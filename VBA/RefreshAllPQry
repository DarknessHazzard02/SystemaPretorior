Sub RefreshAllPowerQueriesInAllWorkbooks() '[Step A] Setup – declare iterators and keep calc automatic for dependency updates
    Dim wb As Workbook, ws As Worksheet, qt As QueryTable, lo As ListObject, cn As WorkbookConnection: Application.Calculation = xlCalculationAutomatic
    '[Step B] Refresh connections – iterate workbook connections commonly used by Power Query
    For Each wb In Application.Workbooks: For Each cn In wb.Connections: If cn.Type = xlConnectionTypeMODEL Or cn.Type = xlConnectionTypeOLEDB Then On Error Resume Next: cn.Refresh: On Error GoTo 0
    Next cn
    '[Step C] Refresh query-backed tables – traverse sheets and update ListObjects sourced from queries
    For Each ws In wb.Worksheets: For Each lo In ws.ListObjects: If lo.SourceType = xlSrcQuery Then On Error Resume Next: lo.QueryTable.Refresh BackgroundQuery:=False: On Error GoTo 0
    Next lo: Next ws: Next wb
End Sub
